      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_front_joint</left_joint>
        <left_joint>left_rear_joint</left_joint>
        <right_joint>right_front_joint</right_joint>
        <right_joint>right_rear_joint</right_joint>
        <wheel_separation>0.62</wheel_separation>
        <wheel_radius>0.14</wheel_radius>
        <topic>/model/tag_rover/cmd_vel</topic>
        <odom_topic>/model/tag_rover/odometry</odom_topic>
        <max_linear_velocity>1</max_linear_velocity>
        <min_linear_velocity>-1</min_linear_velocity>
        <max_angular_velocity>2</max_angular_velocity>
        <min_angular_velocity>-2</min_angular_velocity>
      </plugin>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose>
        <publish_sensor_pose>false</publish_sensor_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <update_frequency>30</update_frequency>
      </plugin>
    </model>
