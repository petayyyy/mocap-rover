<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="rpi_camera">
    <self_collide>false</self_collide>
    <static>false</static>
    <link name="rpi_camera_link">
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.000001</ixx>
          <iyy>0.000001</iyy>
          <izz>0.000001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="rpi_camera_visual">
        <!-- The OBJ mesh lens imports along local +Y; rotate the mesh so the model link +X is the optical direction. -->
        <pose>0 0 0 0 0 -1.5707963</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://rpi_camera/meshes/rpi_camera.obj</uri>
          </mesh>
        </geometry>
      </visual>
      <sensor name="imager" type="camera">
        <!-- Gazebo camera sensors look along local +X, matching this model link's optical direction. -->
        <pose>0 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.74</horizontal_fov>
          <image>
            <width>1280</width>
            <height>960</height>
          </image>
          <clip>
            <!-- The camera sits about 47 mm above the floor while landed. Keep
                 the near plane below that so the takeoff marker is visible. -->
            <near>0.03</near>
            <!-- 50 m is plenty for the indoor/маркерная SITL scene; a 3000 m
                 far plane only wastes depth precision and culling work. -->
            <far>50</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <!-- 15 Hz halves the per-second sensor render cost vs 30 Hz — the camera
             is the most expensive sensor when the SITL server renders on
             llvmpipe (CPU). ArUco VPE fusion is comfortable at 10-15 Hz. -->
        <update_rate>15</update_rate>
        <visualize>false</visualize>
      </sensor>
    </link>
  </model>
</sdf>
